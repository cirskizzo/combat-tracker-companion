<div class="ctc-playlist-config">
  <p class="notes">{{localize "CTC.dialog.playlistConfig.notes"}}</p>

  {{#each slots}}
    <div class="form-group">
      <label>{{localize "CTC.dialog.playlistConfig.slotLabel"}} {{this.number}}</label>
      <select name="slot{{this.index}}">
        <option value="">{{localize "CTC.dialog.playlistConfig.none"}}</option>
        {{#each this.options}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>
  {{/each}}

  <footer class="sheet-footer flexrow">
    <button type="submit">
      <i class="fas fa-save"></i> {{localize "CTC.dialog.playlistConfig.save"}}
    </button>
  </footer>
</div>
